<div class="floors">
        <div class="floor floor-abyss-story">
            <div class="head">
                <div class="floor-name">
                    <div class="floor_num"></div>
                    <div>
                        <div>UID: {{ uid }}</div>
                        <div>{{ title }}•{{ data.floor.name }}</div>
                    </div>
                </div>
                <div class="star">
                    <div>
                        <div>{% if data.extra_star_num %}{{ data.floor.star_num - data.extra_star_num }} + {{ data.extra_star_num }}{% else %}{{ data.floor.star_num }}{% endif %}</div>
                        <div class="score">总分：{{ data.floor.score }}</div>
                    </div>
                </div>
            </div>
            <div class="hr"></div>
            <div class="chamber">
                <div class="chamber-info">
                    <div>
                        使用轮：{{ data.floor.round_num }}
                        <span style="color: #A3A3A3">{{ data.floor_time }}</span>
                    </div>
                    <div class="stars">
                        {% for n in range(data.floor.star_num - data.extra_star_num) %}
                            <div class="star"></div>
                        {% endfor %}
                        {% if data.extra_star_num %}
                            {% for n in range(data.extra_star_num) %}
                                <div class="star star_peak star-extra"></div>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>
                <div class="battles">
                    {% for node in data.floor_nodes %}
                    <div class="battle">
                        {% for character in node.avatars %}
                            <div class="character">
                                {% if character.rank > 0 %}
                                    {% set constellation = character.rank %}
                                    {% set bg = ['blue', 'blue', 'green', 'green', 'red', 'red'][constellation - 1] %}
                                    <div style="background-color: var(--{{ bg }})">
                                        {{ constellation }} 命
                                    </div>
                                {% endif %}
                                <div class="element" style="background-image: url('../../img/element/{{ character.element }}.png')"></div>
                                <div class="icon"
                                     style="background-image: url('../../background/rarity/half/{{ character.rarity }}.png')">
                                    <img src="{{ character.icon }}" alt=""/>
                                </div>
                                <div class="caption">Lv.{{ character.level }}</div>
                            </div>
                        {% endfor %}
                        {% if loop.length > 1 %}
                            <div class="battle-info">
                                <div>节点{{ loop.index }}</div>
                                <br/>
                                <div class="score">积分：{{ node.score }}</div>
                            </div>
                        {% endif %}
                    </div>
                    <div class="buffs">
                        <div class="buff-item">
                            <img src="{{ node.buff.icon }}" alt="buff-item" class="buff-item-icon">
                            <p>
                                <span class="buff-item-name">{{ node.buff.name_mi18n }}：</span>
                                <span class="buff-item-desc">{{ node.buff.desc_mi18n }}</span>
                            </p>
                        </div>
                    </div>
                    {% if loop.index < loop.length %}
                    <div class="hr"></div>
                    {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
</div>
